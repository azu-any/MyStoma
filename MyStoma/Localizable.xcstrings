    "infoitem_wastebag_description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Designed to safely discard used ostomy supplies like pouches, gloves, wipes, or absorbent pads. These bags are often odor-resistant, leakproof, and sealable to maintain hygiene."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bolsa utilizada para desechar de forma segura bolsas de estoma usadas y otros materiales contaminados."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un sacchetto utilizzato per lo smaltimento igienico delle sacche usate."
          }
        }
      }
    },
    "infoitem_wastebag_title" : {
      "localizations" : {
