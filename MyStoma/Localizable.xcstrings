            "value" : "Tutto"
          }
        }
      }
    },
    "An ileostomy brings the end of the small intestine through the belly. The stool is more liquid and comes out often. It needs a drainable pouch. It’s usually needed when the colon can’t be used." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An ileostomy brings the end of the small intestine through the belly. The stool is more liquid and comes out often. It needs a drainable pouch. It’s usually needed when the colon can’t be used."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una ileostomía saca el extremo del intestino delgado a través del abdomen. Las heces son más líquidas y salen con frecuencia. Se necesita una bolsa drenable. Generalmente se necesita cuando no se puede usar el colon."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un'ileostomia porta l'estremità dell'intestino tenue attraverso l'addome. Le feci sono più liquide ed escono frequentemente. È necessaria una sacca drenabile. Di solito è necessaria quando il colon non può essere utilizzato."
          }
        }
      }
    },
    "Anna Paola" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
