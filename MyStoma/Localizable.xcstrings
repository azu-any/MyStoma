    "infoitem_wastebag_description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bag used to safely dispose of used stoma bags and other contaminated materials."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bolsa utilizada para desechar de forma segura bolsas de estoma usadas y otros materiales contaminados."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un sacchetto utilizzato per lo smaltimento igienico delle sacche usate."
          }
        }
