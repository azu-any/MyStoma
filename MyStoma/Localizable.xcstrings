        }
      }
    },
    "infoitem_adhesiveremover_description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gentle spray that helps remove the bag and adhesives without damaging the skin."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un spray suave diseñado para retirar sin esfuerzo las bolsas de estoma y adhesivos médicos de la piel, reduciendo la incomodidad y protegiendo las áreas sensibles durante los cambios de dispositivo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un prodotto utilizzato per rimuovere delicatamente i residui di adesivo dalla pelle."
          }
        }
      }
    },
    "infoitem_adhesiveremover_title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adhesive remover spray"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spray removedor de adhesivo"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuovi Adesivo"
          }
        }
      }
    },
    "infoitem_adhesivespray_description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A spray that improves the adhesion of the stoma bag to the skin, ensuring a more secure hold."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spray que mejora la adhesión o permite retirar la barrera suavemente sin irritar la piel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno spray che aiuta a fissare la sacca alla pelle in modo più sicuro."
          }
        }
      }
    },
    "infoitem_adhesivespray_title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
