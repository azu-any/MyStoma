      }
    },
    "colostomy_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This procedure involves creating a stoma by bringing the colon to the surface of the abdomen. It allows waste to be diverted outside of the body, often in cases of bowel disease or injury."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa procedura prevede la creazione di uno stoma portando il colon sulla superficie dell'addome. Consente di deviare i rifiuti all'esterno del corpo, spesso in caso di malattie o lesioni intestinali."
          }
        }
      }
    },
    "colostomy_subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colon stoma"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estoma del colon"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stomia del colon"
          }
        }
      }
    },
