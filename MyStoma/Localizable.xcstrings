    "infoitem_scissors_description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to cut the wafer to fit the exact size and shape of the stoma when pre-cut options are not suitable. The curved design ensures precise, safe cuts without damaging the protective layer."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tijeras curvas utilizadas para recortar la barrera cutánea al tamaño adecuado del estoma."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Forbici utilizzate per tagliare la barriera cutanea alla dimensione dello stoma."
          }
        }
      }
    },
