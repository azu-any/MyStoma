    "infoitem_wipes_description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placed around the stoma or under the working area to catch any leaks during changes. They protect clothing, skin, and surfaces while ensuring a clean and comfortable procedure."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gasas o toallitas sin alcohol que se usan para limpiar y secar la piel alrededor del estoma."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Salviette umidificate usate per pulire delicatamente la pelle attorno allo stoma."
          }
        }
      }
    },
