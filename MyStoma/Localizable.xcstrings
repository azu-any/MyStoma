            "value" : "Scheda di misurazione della stomia"
          }
        }
      }
    },
    "infoitem_wastebag_description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Designed to safely discard used ostomy supplies like pouches, gloves, wipes, or absorbent pads. These bags are often odor-resistant, leakproof, and sealable to maintain hygiene."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diseñados para desechar de forma segura los materiales usados para ostomía como bolsas, guantes, toallitas o compresas absorbentes. Estas bolsas suelen ser resistentes a los olores, a prueba de fugas y sellables para mantener la higiene."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progettati per eliminare in sicurezza i materiali usati per stomia come sacche, guanti, salviette o assorbenti. Questi sacchetti sono spesso resistenti agli odori, a prova di perdita e richiudibili per mantenere l’igiene."
          }
        }
      }
    },
    "infoitem_wastebag_title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waste bag for stoma bag"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bolsa de basura para bolsa de estoma"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sacca di ricambio per la stomia"
          }
        }
      }
    },
    "infoitem_wipes_description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placed around the stoma or under the working area to catch any leaks during changes. They protect clothing, skin, and surfaces while ensuring a clean and comfortable procedure."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colocados alrededor del estoma o bajo el área de trabajo para captar cualquier fuga durante el cambio. Protegen la ropa, la piel y las superficies, asegurando un procedimiento limpio y cómodo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posizionati intorno allo stoma o sotto l’area di lavoro per raccogliere eventuali perdite durante il cambio. Proteggono i vestiti, la pelle e le superfici garantendo una procedura pulita e confortevole."
          }
        }
      }
    },
    "infoitem_wipes_title" : {
      "localizations" : {
