          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estoma del íleon"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stomia dell’ileo"
          }
        }
      }
    },
