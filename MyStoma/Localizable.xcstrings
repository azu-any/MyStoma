    "Are you sure you want to restart the tutorial? Your current progress will be lost." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure you want to restart the tutorial? Your current progress will be lost."
