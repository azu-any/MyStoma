    "infoitem_scissors_description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Curved scissors used to cut the skin barrier to fit the size of the stoma."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tijeras curvas utilizadas para recortar la barrera cutánea al tamaño adecuado del estoma."
