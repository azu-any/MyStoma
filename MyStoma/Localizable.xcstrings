    "infoitem_adhesiveremover_description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gently lifts the wafer from the skin without pain or damage. Especially useful for sensitive skin or frequent pouch changes, this spray prevents trauma and makes removal easier and safer."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un spray suave diseñado para retirar sin esfuerzo las bolsas de estoma y adhesivos médicos de la piel, reduciendo la incomodidad y protegiendo las áreas sensibles durante los cambios de dispositivo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un prodotto utilizzato per rimuovere delicatamente i residui di adesivo dalla pelle."
          }
        }
      }
    },
    "infoitem_adhesiveremover_title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostomy adhesive remover spray"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Spray removedor de adhesivo"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rimuovi Adesivo"
          }
        }
      }
    },
    "infoitem_adhesivespray_description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adhesive spray improves the wafer’s grip on the skin, while protective wipes form a thin barrier to prevent skin irritation from the adhesive. Both help maintain skin health and appliance security."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Spray que mejora la adhesión o permite retirar la barrera suavemente sin irritar la piel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uno spray che aiuta a fissare la sacca alla pelle in modo più sicuro."
          }
        }
      }
    },
    "infoitem_adhesivespray_title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adhesive spray / Protective wipe"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Spray adhesivo / Removedor"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Spray Adesivo"
          }
        }
      }
    },
    "infoitem_barrierring_description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexible products that fill skin folds and help ensure a snug seal between the wafer and skin. They prevent leaks and protect the skin from irritation caused by output. Rings are pre-shaped; paste is moldable."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anillo o pasta que ayuda a sellar mejor la zona del estoma y evitar fugas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un anello flessibile che si adatta intorno allo stoma per proteggere la pelle."
          }
        }
      }
    },
    "infoitem_barrierring_title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stoma paste or barrier ring"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pasta moldeadora / Anillo de barrera"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anello di Barriera"
          }
        }
      }
    },
    "infoitem_onepiecebag_description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A device combining the adhesive barrier (wafer) and pouch in one. It collects waste from the stoma and can be emptied multiple times before changing. Ideal for frequent output, such as with ileostomies or colostomies."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sistema de una sola pieza que combina la bolsa y la barrera cutánea en un solo producto."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un anello flessibile che si adatta intorno allo stoma per proteggere la pelle."
          }
        }
      }
    },
