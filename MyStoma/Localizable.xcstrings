    "The sea had not abandoned me… it was I who had to learn to return to it." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mar no me había abandonado... era yo quien tenía que aprender a volver a él."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il mare non mi aveva abbandonato… ero io che dovevo imparare a tornare da lui"
