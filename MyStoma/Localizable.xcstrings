    },
    "My stoma is a constant reminder of what I’ve lost. But it’s also a symbol of my strength." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My stoma is a constant reminder of what I’ve lost. But it’s also a symbol of my strength."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi estoma es un recordatorio constante de lo que he perdido. Pero también es un símbolo de mi fuerza."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il mio stoma è un costante promemoria di ciò che ho perso. Ma è anche un simbolo della mia forza"
          }
        }
      }
    },
    "Next step" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Next Step"
          }
        },
        "es-419" : {
