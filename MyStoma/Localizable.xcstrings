            "state" : "translated",
            "value" : "Spray adhesivo / Removedor"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spray Adesivo"
          }
        }
      }
    },
    "infoitem_barrierring_description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ring or paste that helps seal the stoma area better and prevent leaks."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anillo o pasta que ayuda a sellar mejor la zona del estoma y evitar fugas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un anello flessibile che si adatta intorno allo stoma per proteggere la pelle."
          }
        }
      }
    },
