            "state" : "translated",
            "value" : "Forbici"
          }
        }
      }
    },
    "infoitem_stomabag_description" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A medical device that collects body waste after surgeries where a stoma is created."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dispositivo médico que recolecta desechos del cuerpo después de ciertas cirugías en las que se crea un estoma."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sacca che raccoglie i rifiuti corporei provenienti dallo stoma."
          }
